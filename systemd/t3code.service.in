[Unit]
Description=T3 Code web console (Tailnet-bound)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=@HOME@
# @EXTRA_PATH@ holds the directory of mise, when this machine has mise. T3 Code
# installs a provider CLI with a global npm command. The npm shim then calls
# `mise reshim`. Without mise on the path, that call fails with code 127, and
# each provider update in the console fails after a correct install.
Environment=PATH=@NODE_DIR@:@EXTRA_PATH@/usr/local/bin:/usr/bin:/bin
Environment=T3CODE_BIN=@T3_BIN@
Environment=T3CODE_HOME=@T3_HOME@
Environment=T3CODE_PORT=@PORT@
ExecStart=@SERVE_BIN@
Restart=always
RestartSec=5
StandardOutput=append:@STATE_DIR@/t3code.log
StandardError=append:@STATE_DIR@/t3code.log

[Install]
WantedBy=default.target
